{
  "compilerOptions": {
    "target": "es2022",
    "sourceMap": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": false,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vite/client"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "paths": {
      "ts-priority-queue": [
        "./src/types/ts-priority-queue.d.ts"
      ]
    }
  },
  // Only the browser sources. vite.config.mts imports Vite's Node API, which would
  // otherwise pull NodeJS ambient globals in and make setTimeout return Timeout
  // instead of number. Vite type-checks and transpiles its own config on load.
  "include": [
    "src"
  ],
  "typedocOptions": {
    "entryPointStrategy": "expand",
    "entryPoints": [
      "src"
    ],
    "out": "../documentation/client"
  }
}