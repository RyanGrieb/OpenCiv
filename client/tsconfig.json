{
  "compilerOptions": {
    "target": "es2022",
    "sourceMap": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": false,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "module": "es2022",
    "moduleResolution": "bundler"
  },
  "typedocOptions": {
    "entryPointStrategy": "expand",
    "entryPoints": [
      "src"
    ],
    "out": "../documentation/client"
  }
}